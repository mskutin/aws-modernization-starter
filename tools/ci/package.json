{
  "name": "@starter/tool-ci",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "CI/CD supply-chain helpers: pinning and exception-expiry checks, license policy, provenance statements, report converters and job scripts.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "supply-chain:lint": "node src/cli.ts supply-chain-lint",
    "licenses": "node src/cli.ts licenses"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
