{
  "BudgetName": "starter-dev-monthly",
  "BudgetType": "COST",
  "TimeUnit": "MONTHLY",
  "BudgetLimit": { "Amount": "150", "Unit": "USD" },
  "FilterExpression": {
    "And": [
      {
        "Tags": {
          "Key": "Project",
          "Values": ["aws-modernization-starter"],
          "MatchOptions": ["EQUALS"]
        }
      },
      { "Tags": { "Key": "Environment", "Values": ["dev"], "MatchOptions": ["EQUALS"] } }
    ]
  }
}
