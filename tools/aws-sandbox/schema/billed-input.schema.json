{
  "title": "starter-aws-sandbox billed-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "starter-aws-sandbox/billed-input"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "phase": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "source": {
      "type": "string",
      "enum": ["billing-console", "cost-explorer-console", "invoice"]
    },
    "readAt": {
      "type": "string",
      "minLength": 10
    },
    "readBy": {
      "type": "string",
      "minLength": 1
    },
    "periodStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "periodEnd": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "resourcesCreatedAt": {
      "type": "string",
      "minLength": 10
    },
    "teardownCompletedAt": {
      "type": "string",
      "minLength": 10
    },
    "baselineUsdPerDay": {
      "type": "number",
      "minimum": 0
    },
    "accountTotalUsd": {
      "type": "number",
      "minimum": 0
    },
    "taxIncluded": {
      "type": "boolean"
    },
    "byService": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "runId",
    "phase",
    "source",
    "readAt",
    "readBy",
    "periodStart",
    "periodEnd",
    "resourcesCreatedAt",
    "teardownCompletedAt",
    "baselineUsdPerDay",
    "accountTotalUsd",
    "taxIncluded",
    "byService"
  ],
  "additionalProperties": false
}
