{
  "title": "starter-aws-sandbox inventory",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "starter-aws-sandbox/inventory"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 10
    },
    "runId": {
      "type": "string"
    },
    "phase": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "region": {
      "type": "string"
    },
    "account": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\*{8}\\d{4}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "executionProfile": {
      "type": "string",
      "const": "personal-sandbox"
    },
    "readOnly": {
      "type": "boolean",
      "const": true
    },
    "status": {
      "type": "string",
      "enum": ["ok", "incomplete", "no-stacks", "guard-refused", "error"]
    },
    "statusReason": {
      "type": "string"
    },
    "stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": ["string", "null"]
          },
          "status": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "lastUpdatedAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "terminationProtection": {
            "type": "boolean"
          },
          "tags": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "logicalId": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "physicalId": {
                  "type": ["string", "null"]
                },
                "status": {
                  "type": ["string", "null"]
                },
                "createdAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 10
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastUpdatedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 10
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "hourlyUsd": {
                  "type": "number"
                },
                "nestedStack": {
                  "type": "string"
                }
              },
              "required": [
                "logicalId",
                "type",
                "physicalId",
                "status",
                "createdAt",
                "lastUpdatedAt",
                "hourlyUsd"
              ],
              "additionalProperties": false
            }
          },
          "hourlyUsd": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "id",
          "status",
          "createdAt",
          "lastUpdatedAt",
          "terminationProtection",
          "tags",
          "resources",
          "hourlyUsd"
        ],
        "additionalProperties": false
      }
    },
    "bootstrap": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "id": {
              "type": ["string", "null"]
            },
            "status": {
              "type": ["string", "null"]
            },
            "createdAt": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 10
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastUpdatedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 10
                },
                {
                  "type": "null"
                }
              ]
            },
            "terminationProtection": {
              "type": "boolean"
            },
            "tags": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "logicalId": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "physicalId": {
                    "type": ["string", "null"]
                  },
                  "status": {
                    "type": ["string", "null"]
                  },
                  "createdAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 10
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lastUpdatedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 10
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "hourlyUsd": {
                    "type": "number"
                  },
                  "nestedStack": {
                    "type": "string"
                  }
                },
                "required": [
                  "logicalId",
                  "type",
                  "physicalId",
                  "status",
                  "createdAt",
                  "lastUpdatedAt",
                  "hourlyUsd"
                ],
                "additionalProperties": false
              }
            },
            "hourlyUsd": {
              "type": "number"
            }
          },
          "required": [
            "name",
            "id",
            "status",
            "createdAt",
            "lastUpdatedAt",
            "terminationProtection",
            "tags",
            "resources",
            "hourlyUsd"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "experimentResources": {
      "type": "object",
      "properties": {
        "kmsKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stack": {
                "type": "string"
              },
              "logicalId": {
                "type": "string"
              },
              "keyId": {
                "type": "string"
              },
              "arn": {
                "type": ["string", "null"]
              }
            },
            "required": ["stack", "logicalId", "keyId", "arn"],
            "additionalProperties": false
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stack": {
                "type": "string"
              },
              "logicalId": {
                "type": "string"
              },
              "arn": {
                "type": "string"
              }
            },
            "required": ["stack", "logicalId", "arn"],
            "additionalProperties": false
          }
        },
        "logGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stack": {
                "type": "string"
              },
              "logicalId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["stack", "logicalId", "name"],
            "additionalProperties": false
          }
        }
      },
      "required": ["kmsKeys", "secrets", "logGroups"],
      "additionalProperties": false
    },
    "otherRunStacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "runId": {
            "type": ["string", "null"]
          }
        },
        "required": ["name", "runId"],
        "additionalProperties": false
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "disclaimer": {
          "type": "string"
        },
        "estimateBasis": {
          "type": "string",
          "enum": ["contract", "synth"]
        },
        "priceBasis": {
          "type": "string"
        },
        "resourcesUsdPerHour": {
          "type": "number"
        },
        "otherUsdPerHour": {
          "type": "number"
        },
        "totalUsdPerHour": {
          "type": "number"
        },
        "oneTimeUsd": {
          "type": "number"
        },
        "partialHourRoundingUsd": {
          "type": "number"
        },
        "accountLevelUsd": {
          "type": "number"
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsedHours": {
          "type": ["number", "null"]
        },
        "estimatedSpendSoFarUsd": {
          "type": ["number", "null"]
        }
      },
      "required": [
        "disclaimer",
        "estimateBasis",
        "priceBasis",
        "resourcesUsdPerHour",
        "otherUsdPerHour",
        "totalUsdPerHour",
        "oneTimeUsd",
        "partialHourRoundingUsd",
        "accountLevelUsd",
        "startedAt",
        "elapsedHours",
        "estimatedSpendSoFarUsd"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "stopUsd": {
          "type": "number"
        },
        "spentUsd": {
          "type": "number"
        },
        "marginPercent": {
          "type": "number"
        },
        "taxRatePercent": {
          "type": "number"
        },
        "maxRuntimeHours": {
          "type": "number"
        },
        "timeBoxHours": {
          "type": "number"
        },
        "effectiveMaxRuntimeHours": {
          "type": "number"
        },
        "bindingLimit": {
          "type": "string",
          "enum": ["time-box", "stop-rule"]
        },
        "teardownStartBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "allDeletedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAtTag": {
          "type": ["string", "null"]
        },
        "basis": {
          "type": "string"
        }
      },
      "required": [
        "stopUsd",
        "spentUsd",
        "marginPercent",
        "taxRatePercent",
        "maxRuntimeHours",
        "timeBoxHours",
        "effectiveMaxRuntimeHours",
        "bindingLimit",
        "teardownStartBy",
        "allDeletedBy",
        "expiresAtTag",
        "basis"
      ],
      "additionalProperties": false
    },
    "teardown": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "verifyCommand": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["owner", "command", "verifyCommand", "notes"],
      "additionalProperties": false
    },
    "guard": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "account": {
                "type": "string",
                "pattern": "^\\*{8}\\d{4}$"
              },
              "principalArn": {
                "type": "string"
              },
              "principalType": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "executionProfile": {
                "type": "string",
                "const": "personal-sandbox"
              }
            },
            "required": [
              "time",
              "label",
              "account",
              "principalArn",
              "principalType",
              "region",
              "executionProfile"
            ],
            "additionalProperties": false
          }
        },
        "refusal": {
          "type": ["string", "null"]
        },
        "maxAgeSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["checks", "refusal", "maxAgeSeconds"],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "awsCli": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "version": {
                  "type": ["string", "null"]
                }
              },
              "required": ["path", "sha256", "version"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "guardCli": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": ["string", "null"]
            }
          },
          "required": ["path", "sha256"],
          "additionalProperties": false
        },
        "awsCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "iamAction": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "errorCode": {
                "type": "string"
              }
            },
            "required": ["service", "operation", "iamAction", "ok"],
            "additionalProperties": false
          }
        }
      },
      "required": ["awsCli", "guardCli", "awsCalls"],
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["operation", "kind", "code", "message"],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "generatedAt",
    "runId",
    "phase",
    "region",
    "account",
    "executionProfile",
    "readOnly",
    "status",
    "statusReason",
    "stacks",
    "bootstrap",
    "experimentResources",
    "otherRunStacks",
    "cost",
    "runtime",
    "teardown",
    "guard",
    "tool",
    "errors",
    "notes"
  ],
  "additionalProperties": false
}
