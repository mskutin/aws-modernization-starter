{
  "name": "@starter/config",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Fail-fast, zod-validated environment configuration for the API and Lambda functions.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./region": {
      "types": "./dist/region.d.ts",
      "default": "./dist/region.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {}
}
