{
  "name": "@starter/contracts",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Versioned API contracts (zod v4 schemas) and the generated OpenAPI 3.1 document.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/index.d.ts",
      "default": "./dist/v1/index.js"
    },
    "./openapi/v1.json": "./openapi/v1.json"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {}
}
