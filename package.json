{
  "name": "aws-modernization-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AWS modernization starter monorepo: React SPA, Fastify API on ECS, Step Functions + Lambda workflow, RDS PostgreSQL, DynamoDB, CDK v2, policy-as-code and GitLab CI.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "typecheck": "pnpm -r --workspace-concurrency=4 run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --workspace-concurrency=4 run test",
    "test:integration": "pnpm -r --workspace-concurrency=1 run test:integration",
    "impact": "node tools/impact/src/cli.ts",
    "ci:generate": "node tools/impact/src/cli.ts generate",
    "ci:check": "node tools/impact/src/cli.ts generate --check && node tools/ci/src/cli.ts supply-chain-lint --out reports/supply-chain",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "sh scripts/git-hooks/install.sh || echo 'git hooks not installed (optional; CI runs every check)'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "yaml": "2.9.1"
  }
}
