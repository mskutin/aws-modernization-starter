{
  "name": "@starter/tests-e2e",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Playwright (Chromium) end-to-end tests of the SPA against a running web tier (WEB_BASE_URL).",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:aws-auth-offline": "playwright test -c support/aws-auth.offline.config.ts",
    "browsers:install": "playwright install chromium",
    "report": "playwright show-report ../../reports/e2e-html"
  },
  "devDependencies": {
    "@starter/testing": "workspace:*",
    "@playwright/test": "1.63.0"
  }
}
