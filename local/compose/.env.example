# Local-only settings for the starter-app Podman Compose stack (local/compose/compose.yaml).
#
# local/compose/bin/dev-up.sh copies this file on first run to the env file OUTSIDE the repository,
# ${STARTER_LOCAL_STATE_DIR:-${XDG_STATE_HOME:-~/.local/state}/starter-app/compose}/.env (mode 600),
# and replaces every __GENERATE__ with its own random value. NEVER put real credentials here or
# in .env — on AWS the runtime identities use RDS IAM authentication (no password at all) and only
# the one-off bootstrap task reads the RDS master secret, at runtime.

# PostgreSQL superuser of the starter-app-pgdata volume (initdb). Used ONLY by the one-shot
# postgres-admin and db-bootstrap services, never by the API.
POSTGRES_ADMIN_USER=starter_admin
POSTGRES_ADMIN_PASSWORD=__GENERATE__
POSTGRES_DB=starter_app

# Least-privilege login roles, created and kept in sync by the db-bootstrap service (ADR 0220):
# migrate runs as starter_migrator, the API as starter_app, the local simulator's document reads as
# starter_processor, the retention job (disabled by default) as starter_retention.
STARTER_MIGRATOR_PASSWORD=__GENERATE__
STARTER_APP_PASSWORD=__GENERATE__
STARTER_PROCESSOR_PASSWORD=__GENERATE__
STARTER_RETENTION_PASSWORD=__GENERATE__

JOBS_TABLE_NAME=starter-app-jobs-local
AWS_REGION=ap-southeast-1
LOG_LEVEL=info

# Optional host-port overrides (defaults per docs/contracts.md section 6)
# STARTER_PG_HOST_PORT=15432
# STARTER_DYNAMODB_HOST_PORT=18000
# STARTER_API_HOST_PORT=8080
# STARTER_WEB_HOST_PORT=4173
# STARTER_IDP_HOST_PORT=9400   (TEST ONLY identity provider)

# Workflow: in-process stale-job reconciler of the local simulation (seconds; 0 = disabled).
# Stale threshold etc.: RECONCILER_STALE_AFTER_SECONDS (>= 660), RECONCILER_BATCH_SIZE, RECONCILER_DRY_RUN.
RECONCILER_LOCAL_INTERVAL_SECONDS=0
